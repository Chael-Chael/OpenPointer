{
  "name": "openpointer",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPointer desktop AI pointer assistant.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-cua.mjs --patch-only",
    "setup:cua": "node scripts/setup-cua.mjs",
    "cua:prepare": "node scripts/setup-cua.mjs --build --require-build",
    "cua:verify": "node scripts/verify-cua-driver.mjs",
    "test:cua": "npm run cua:prepare && npm run cua:verify && npm test",
    "codex:adapter": "python scripts/codex-python-adapter.py --host 127.0.0.1 --port 5050",
    "dev": "npm run dev -w @openpointer/desktop",
    "build": "npm run build -w @openpointer/core && npm run build -w @openpointer/gestures && npm run build -w @openpointer/voice && npm run build -w @openpointer/backends && npm run build -w @openpointer/grounding && npm run build -w @openpointer/storage && npm run build -w @openpointer/agent-bridge && npm run build -w @openpointer/desktop",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.12.12",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "prettier": "3.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.21.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.158"
  }
}
