{
  "name": "@openmagicpointer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:ts\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:ts": "tsc -b tsconfig.json tsconfig.node.json --watch",
    "dev:vite": "wait-on ../../packages/core/dist/index.js ../../packages/gestures/dist/index.js ../../packages/intent/dist/index.js ../../packages/storage/dist/index.js ../../packages/voice/dist/index.js && vite --host 127.0.0.1",
    "dev:electron": "wait-on ../../packages/backends/dist/index.js ../../packages/core/dist/index.js ../../packages/executors/dist/index.js ../../packages/gestures/dist/index.js ../../packages/grounding/dist/index.js ../../packages/intent/dist/index.js ../../packages/storage/dist/index.js dist-electron/main/main.js tcp:5173 && electron .",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@openmagicpointer/backends": "0.1.0",
    "@openmagicpointer/core": "0.1.0",
    "@openmagicpointer/executors": "0.1.0",
    "@openmagicpointer/gestures": "0.1.0",
    "@openmagicpointer/grounding": "0.1.0",
    "@openmagicpointer/intent": "0.1.0",
    "@openmagicpointer/storage": "0.1.0",
    "@openmagicpointer/voice": "0.1.0",
    "electron": "^42.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
