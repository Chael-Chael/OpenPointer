{
  "name": "@openpointer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 dist-electron/main/main.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@openpointer/agent-bridge": "0.1.0",
    "@openpointer/backends": "0.1.0",
    "@openpointer/core": "0.1.0",
    "@openpointer/gestures": "0.1.0",
    "@openpointer/grounding": "0.1.0",
    "@openpointer/storage": "0.1.0",
    "@openpointer/voice": "0.1.0",
    "get-windows": "^9.3.0",
    "electron": "^42.2.0",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
