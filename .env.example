# OpenPointer local configuration.
# Never commit real API keys. Copy this file to .env for local development.

OP_AGENT_BACKEND=codex

OP_LOCAL_VLM_ENABLED=true
OP_LOCAL_VLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
OP_LOCAL_VLM_MODEL=
OP_LOCAL_VLM_API_KEY=

OP_HERMES_BASE_URL=http://127.0.0.1:8642/v1
OP_HERMES_API_KEY=
OP_OPENCODE_BASE_URL=
OP_OPENCODE_API_KEY=
OP_CLAUDE_AGENT_ENABLED=false
OP_CLAUDE_AGENT_API_KEY=
OP_CODEX_APP_SERVER_TRANSPORT=http-adapter
OP_CODEX_APP_SERVER_URL=http://127.0.0.1:5050/v1
OP_CODEX_EXECUTABLE=
OP_CODEX_API_KEY=
OP_CODEX_MODEL=gpt-5.4
OP_CODEX_EFFORT=low
OP_CODEX_SANDBOX=workspace-write
OP_CODEX_WORKSPACE=
OP_CUA_MODE=prefer
